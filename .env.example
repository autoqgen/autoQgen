# ---------------------------------------------------------------------------
# AutoQgen — environment configuration
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# All variables are validated at startup by src/lib/config/env.ts.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/autoqgen
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/autoqgen

# Optional: overrides the database name embedded in MONGODB_URI.
# MONGODB_DB_NAME=autoqgen

# --- Auth.js / NextAuth (required) -----------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-at-least-32-random-characters

# Full public origin of this deployment. No trailing slash.
# There is deliberately NO localhost fallback in production.
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (optional) -----------------------------------------------
# Leave both blank to disable the Google provider entirely.
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Runtime ---------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info

# Set to "true" ONLY in local development to print password-reset URLs to the
# server log instead of sending email. Forced off when NODE_ENV=production.
AUTH_DEBUG_RESET_URL=false

# --- Seed script (development only) ----------------------------------------
# Password assigned to every seeded development account.
# The seed script refuses to run when NODE_ENV=production.
SEED_PASSWORD=DevPassword123!

# ---------------------------------------------------------------------------
# STEP 2 ADDITIONS
# ---------------------------------------------------------------------------

# --- Email delivery --------------------------------------------------------
# Leave SMTP_HOST empty in development: the console transport logs the subject
# and recipient instead of sending. Production logs an error if it is missing,
# and password-reset emails will NOT be delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=AutoQgen <no-reply@autoqgen.local>
# Optional. Shown in emails as a contact address.
EMAIL_SUPPORT=

# --- Security --------------------------------------------------------------
# Extra origins allowed to make state-changing requests, comma separated.
# NEXTAUTH_URL is always trusted; add others only if you front the app with a
# second hostname.
ALLOWED_ORIGINS=

# --- Rate limiting ---------------------------------------------------------
# The default in-memory limiter is per-instance. To share counters across
# replicas, provide a Redis URL and register RedisRateLimitStore at boot
# (see src/lib/rate-limit/redis-store.ts for the three-line wiring).
REDIS_URL=

# --- AI question generation (Google Gemini) ------------------------------
# Powers the "AI Generated Questions" page. Leave GEMINI_API_KEY empty to
# disable the feature (the page shows an "unavailable" notice).
#
# Get a free key at https://aistudio.google.com/apikey — the free tier is
# enough for demo use. The key is used ONLY server-side and is never exposed
# to the browser.
GEMINI_API_KEY=
# Currently-available free-tier model. Override only if the free tier changes.
# New API keys are directed to gemini-3.6-flash; older flash models are refused.
GEMINI_MODEL=gemini-3.6-flash
# Embedding model for the per-paper "Similarities" semantic check. Uses the same
# GEMINI_API_KEY above. Override only if the current embedding model changes.
# (text-embedding-004 was retired by Google; gemini-embedding-001 replaces it.)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
